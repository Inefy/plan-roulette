# .env.example
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Never put a Supabase service role key in Expo or any client-side app.
# The anon key is public, so every table accessed by the app must be protected by strict RLS policies.
# Use these same Expo public variables in EAS build environments.
