{
  "expo": {
    "name": "Plan Roulette",
    "slug": "plan-roulette",
    "description": "Create a room, invite your group, vote on plans, and turn the winning choice into a shareable itinerary.",
    "scheme": "planroulette",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.planroulette.mobile",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:planroulette.app",
        "applinks:www.planroulette.app"
      ],
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "app.planroulette.mobile",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "planroulette.app",
              "pathPrefix": "/join"
            },
            {
              "scheme": "https",
              "host": "www.planroulette.app",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8EA",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Plan Roulette to access your calendar so it can add final plans.",
          "remindersPermission": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "adda1f5a-7d72-4f22-9d2b-80b3313da437"
      }
    },
    "owner": "zacbatten"
  }
}
